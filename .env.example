# 复制为 .env 后填写真实值. 本文件仅作模板, 真实凭据的 .env 禁止提交版本控制.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=memory_agent

LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=30

RECENT_MESSAGE_LIMIT=10
MAX_FACTS_INJECTED=8

# 知识库 (Milvus 不可达时自动降级, 留空则完全关闭; 必须带 http:// 前缀)
MILVUS_URI=http://43.143.233.242:19530
EMBED_MODEL=BAAI/bge-small-zh-v1.5
# HuggingFace 国内镜像 (国内网络下载 embedding 模型需要)
HF_ENDPOINT=https://hf-mirror.com
KB_CHUNK_SIZE=500
KB_CHUNK_OVERLAP=50
KB_TOP_K=4
